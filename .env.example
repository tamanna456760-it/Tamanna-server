# Tamanna Central Server — local/production environment template
APP_ENV=development
APP_DEBUG=false
HOST=0.0.0.0
PORT=8000

# Generate a unique private token on the server: openssl rand -hex 32
ORCHESTRATOR_TOKEN=
DATABASE_URL=sqlite:///./data/reports.db

# Exact browser origins only; never use a wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bd-king-r7.com,https://www.bd-king-r7.com

MAX_CONTENT_LENGTH=1048576
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY=false

# Optional services; keep all real credentials in local .env or a secret manager.
ANALYTICS_API_TOKEN=
MEDICAL_API_TOKEN=
APP_SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Service-to-service protocol v1 (share the same 64+ hex secret with Tamanna AI privately)
TAMANNA_SERVICE_KEY_ID=tamanna-ai
TAMANNA_SERVICE_SHARED_SECRET=
TAMANNA_PROTOCOL_CLOCK_SKEW_SECONDS=300\n# Shared atomic replay protection for service protocol (production)\nTAMANNA_PROTOCOL_REDIS_URL=redis://protocol-redis:6379/0\n