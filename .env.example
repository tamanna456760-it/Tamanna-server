# Tamanna Central Server — local/production environment template
# Copy to .env, set a unique token, then chmod 600 .env.
APP_ENV=development
APP_DEBUG=false
HOST=127.0.0.1
PORT=8000

# Generate with: openssl rand -hex 32
ORCHESTRATOR_TOKEN=

# SQLite example. Docker Compose uses /app/data/reports.db by default.
DATABASE_URL=sqlite:///./data/reports.db

# Comma-separated exact origins; no wildcard.
CORS_ORIGINS=http://localhost:3000,https://www.tamanna.com

# Request and abuse controls
MAX_CONTENT_LENGTH=1048576
RATE_LIMIT_PER_MINUTE=60

# Set true only when every request reaches the app through your trusted Nginx proxy.
TRUST_PROXY=false

# Optional legacy analytics/medical services (not included in the default Compose stack).
ANALYTICS_API_TOKEN=
MEDICAL_API_TOKEN=
APP_SECRET_KEY=
SESSION_COOKIE_SECURE=true
