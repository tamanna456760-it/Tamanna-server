# Tamanna Central Server — local/production environment template
APP_ENV=development
APP_DEBUG=false
HOST=0.0.0.0
PORT=8000

# Generate a unique private token on the server: openssl rand -hex 32
ORCHESTRATOR_TOKEN=
DATABASE_URL=sqlite:///./data/reports.db

# Production browser origins only; add localhost origins only in a private development .env.
CORS_ORIGINS=https://bd-king-r7.com,https://www.bd-king-r7.com

MAX_CONTENT_LENGTH=1048576
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY=false

# Optional services; keep all real credentials in local .env or a secret manager.
ANALYTICS_API_TOKEN=
MEDICAL_API_TOKEN=
APP_SECRET_KEY=
SESSION_COOKIE_SECURE=true

# Service-to-service protocol v1 (share the same 64+ hex secret with Tamanna AI privately)
TAMANNA_SERVICE_KEY_ID=tamanna-ai
TAMANNA_SERVICE_SHARED_SECRET=
TAMANNA_PROTOCOL_CLOCK_SKEW_SECONDS=300
# Shared atomic replay protection for service protocol (production)
TAMANNA_PROTOCOL_REDIS_URL=redis://protocol-redis:6379/0

# Two-way ChatGPT <-> Tamanna bridge (generate independent random secrets)
MCP_BEARER_TOKEN=
TAMANNA_BRIDGE_SERVICE_TOKEN=
BRIDGE_MAX_MESSAGE_CHARS=12000

# Optional Tamanna AI FastAPI + local Ollama stack (start with --profile ai).
# Generate a private value: openssl rand -hex 32
TAMANNA_ENV=production
TAMANNA_MODEL_PROVIDER=ollama
TAMANNA_OLLAMA_MODEL=qwen2.5:7b
TAMANNA_SESSION_SECRET=
TAMANNA_ADMIN_EMAIL=Tamanna456760@gmail.com
TAMANNA_CORS_ORIGINS=https://www.bd-king-r7.com
