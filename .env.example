
# ==========================================
# TAMANNA CENTRAL SERVER
# Environment Configuration
# ==========================================

APP_NAME=Tamanna Central Server
APP_ENV=development
APP_DEBUG=false

# Main server
HOST=0.0.0.0
PORT=8000

# Authentication
ORCHESTRATOR_TOKEN=

# AI provider
AI_MODE=local
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEP_API_KEY=

# Database
DATABASE_URL=sqlite:///./data/tamanna.db

# Security
CORS_ORIGINS=http://localhost:3000
MAX_CONTENT_LENGTH=1048576
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_DIRECTORY=logs

# Backup
BACKUP_ENABLED=true
BACKUP_DIRECTORY=backups

# Health monitoring
HEALTH_CHECK_ENABLED=true
