{
  "application": {
    "name": "Tamanna AI",
    "id": "tamanna-ai",
    "version": "2.0.0",
    "description": "Tamanna AI Modular Intelligence and Automation Platform",
    "author": "HM INSAN ALI",
    "system": "BD KING R7",
    "environment": "production"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "protocol": "https",
    "publicUrl": "https://www.bd-king-r7.com",
    "redirectHttpToHttps": true,
    "trustProxy": false
  },
  "domains": {
    "primary": "bd-king-r7.com",
    "www": "www.bd-king-r7.com",
    "allowedHosts": ["bd-king-r7.com", "www.bd-king-r7.com"],
    "forceCanonicalHost": "www.bd-king-r7.com"
  },
  "security": {
    "enabled": true,
    "rateLimit": {"enabled": true, "requestsPerMinute": 120},
    "cors": {
      "enabled": true,
      "allowedOrigins": ["https://bd-king-r7.com", "https://www.bd-king-r7.com"],
      "allowCredentials": false
    },
    "https": {"requiredInProduction": true, "hsts": true, "certificateManagedExternally": true},
    "authentication": {"requiredForAdmin": true, "provider": "configure-separately"},
    "secrets": {"storeInEnvironmentVariables": true, "commitSecretsToGit": false}
  },
  "api": {"enabled": true, "basePath": "/api", "healthEndpoint": "/health", "requestTimeoutSeconds": 30},
  "features": {
    "chat": true, "voice": false, "memory": true, "projectContext": true,
    "moduleRouter": true, "webResearch": true, "fileOperations": true,
    "githubIntegration": true, "automaticCodeChanges": false,
    "approvalBeforeDestructiveChanges": true
  },
  "database": {"enabled": false, "provider": "none"},
  "logging": {"enabled": true, "level": "Information", "directory": "logs/", "redactSecrets": true},
  "backup": {"enabled": true, "beforeUpgrade": true, "retainedCopies": 7, "restoreRequiresApproval": true},
  "deployment": {
    "mode": "production",
    "automaticDeployment": false,
    "healthCheckRequired": true,
    "requireBackup": true,
    "requireSuccessfulBuild": true,
    "requireApprovalForProduction": true
  },
  "metadata": {"schemaVersion": "1.0", "owner": "HM INSAN ALI", "product": "Tamanna AI"}
}
